<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="Definitions_MultiInstanceApprox"
                  targetNamespace="http://example.com/benchmarks/multi-instance">
  <bpmn:process id="Process_MultiInstanceApprox" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="Batch Start" />
    <bpmn:userTask id="Task_Review" name="Review Items">
      <bpmn:multiInstanceLoopCharacteristics isSequential="false" />
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_Aggregate" name="Aggregate Result" />
    <bpmn:endEvent id="End_1" name="Batch End" />

    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Task_Review" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Review" targetRef="Task_Aggregate" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Aggregate" targetRef="End_1" />
  </bpmn:process>
</bpmn:definitions>
